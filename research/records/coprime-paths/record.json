{
  "schema_version": 1,
  "id": "coprime-paths",
  "title": "Coprime paths: the nine-edge threshold, linear bounds, and reproducible evidence",
  "version": "2026.10.20",
  "authors": [
    {
      "given_names": "Alexander Richard",
      "family_names": "Towell",
      "orcid": "0000-0001-6443-9897",
      "affiliation": "Southern Illinois University Edwardsville",
      "email": "lex@metafunctor.com"
    }
  ],
  "abstract": "The coprime graph on 1,...,17 forces a monochromatic simple nine-edge path in every two-edge-coloring, while a complete coloring at 16 avoids one. The upper bound combines a written extremal classification with independently checked finite host lemmas. The record also preserves earlier independently recertified seven- and eight-edge thresholds, linear bounds, an author-revised manuscript, and clearly separated exploratory findings. Human mathematical review and novelty assessment remain incomplete.",
  "keywords": [
    "coprime graph",
    "Ramsey theory",
    "monochromatic paths",
    "extremal graph theory",
    "finite certificates",
    "reproducible research",
    "written mathematical proof"
  ],
  "licenses": {
    "code": "MIT",
    "papers": "CC-BY-4.0"
  },
  "source": {
    "repository": "https://github.com/queelius/computational-explorations",
    "commit": "1e00700a86bbb13c4b0800eaa9a708b857c8e439",
    "evidence_commit": "8bda81e8d3f867bb1450b0e492592164416ba98f"
  },
  "claims": [
    {
      "id": "nine-edge-threshold",
      "statement": "P_cop(9) = 17.",
      "status": "written_proof",
      "evidence": [
        "docs-coprime-path-nine-resolution-2026-10-18-md",
        "docs-audits-coprime-path-nine-resolution-2026-10-18-lower-n16-k9-json",
        "docs-audits-coprime-path-nine-2026-10-18-cuts-json-gz",
        "docs-audits-coprime-path-nine-2026-10-18-fault-families-json-gz",
        "docs-audits-coprime-path-nine-2026-10-18-extensions-json-gz"
      ]
    },
    {
      "id": "earlier-thresholds",
      "statement": "Earlier public values P_cop(7) = P_cop(8) = 13 independently recertified.",
      "status": "prior_result_reverified",
      "evidence": [
        "docs-audits-coprime-paths-2026-10-18-manifest-json"
      ]
    },
    {
      "id": "linear-bounds",
      "statement": "2 <= liminf P_cop(k)/k <= limsup P_cop(k)/k <= 197*pi^2/595.",
      "status": "written_proof",
      "evidence": [
        "docs-coprime-path-structure-2026-10-18-md",
        "src-coprime-path-bounds-py"
      ]
    }
  ],
  "assumptions": [
    "G_n has vertices 1,...,n and an edge between distinct coprime integers.",
    "Two edge colors; simple paths; P_cop(k) counts edges.",
    "P_j in the extremal graph sources counts vertices. Published source hypotheses are part of the written proof."
  ],
